@url = http://localhost:3000

### Resistro Usuario

# @name register
POST {{url}}/auth/register 
Content-Type: application/json

{
    "nombre": "Leonel",
    "email": "leonel@test.com",
    "password": "hola1234"
}

### Login

# @name login
POST {{url}}/auth/login 
Content-Type: application/json

{
    "email": "leonel@test.com",
    "password": "hola1234"
}

###
@token = {{login.response.body.token}}
